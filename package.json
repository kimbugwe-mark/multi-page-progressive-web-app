{
  "name": "morrow-journal",
  "type": "module",
  "version": "0.0.0",
  "description": "A simple journal app built with Hono, Express, and TypeScript.",
  "author": "Kimbugwe Mark",
  "license": "MIT",
  "homepage": "https://github.com/kimbugwe-mark/multi-page-progressive-web-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimbugwe-mark/multi-page-progressive-web-app.git"
  },
  "bugs": {
    "url": "https://github.com/kimbugwe-mark/multi-page-progressive-web-app/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "node --watch dist/index.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/service-worker": "^1.0.0",
    "achi-html-stream": "^1.0.3",
    "express": "^5.2.1",
    "hono": "^4.13.13"
  },
  "inlinedDependencies": {
    "@hono/service-worker": "1.0.0",
    "achi-html-stream": "1.0.3",
    "hono": "4.13.13"
  }
}
